BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_API_KEY=replace-with-your-real-api-key
LOG_LEVEL=INFO
# For Docker, localhost inside the container is the container itself.
# If your database runs on the host machine, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql+psycopg://app_user:app_password@host.docker.internal:5432/awesome_ai_profile
VECTOR_STORE_PATH=data/chroma
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_RESULT_LIMIT=5
MAX_PDF_SIZE_MB=10
UPLOAD_TTL_MINUTES=30
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_MAX_TURNS=20

# Optional omnichannel proof of concept. Keep secrets server-side.
CHANNEL_DEFAULT_LOCALE=es
CHANNEL_PUBLIC_BASE_URL=https://api.example.com
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-your-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
META_GRAPH_API_VERSION=v26.0
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
