BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_API_KEY=replace-with-your-real-api-key
# For Docker, localhost inside the container is the container itself.
# If your database runs on the host machine, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql+psycopg://app_user:app_password@host.docker.internal:5432/awesome_ai_profile
