BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_API_KEY=replace-with-your-real-api-key
# For Docker, localhost inside the container is the container itself.
# If your database runs on the host machine, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql+psycopg://app_user:app_password@host.docker.internal:5432/awesome_ai_profile
VECTOR_STORE_PATH=data/chroma
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_RESULT_LIMIT=5
MAX_PDF_SIZE_MB=10
UPLOAD_TTL_MINUTES=30

# Safe default. No real email until mode=resend AND enabled=true with all settings.
CONTACT_DELIVERY_MODE=simulation
CONTACT_EMAIL_ENABLED=false
RESEND_API_KEY=
# For a controlled test only; production should use your verified domain.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Contact state lives in RAM. Use one backend process / one active replica.
# Restart/deploy/scale-to-zero loses sessions, receipts and these counters.
CONTACT_DAILY_LIMIT=20
CONTACT_SESSIONS_PER_HOUR=60
CONTACT_MAX_SESSIONS=10000
